# Copia este fichero a .env y rellena los valores. No lo subas al repositorio.

# Perfil de Spring: dev (H2 en archivo, por defecto) o prod (PostgreSQL)
SPRING_PROFILES_ACTIVE=prod

# Secreto para firmar los JWT (obligatorio en prod, mínimo 32 bytes). Genera uno con: openssl rand -base64 48
JWT_SECRET=

# Administrador inicial: se crea al arrancar si no existe un usuario con ese email
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# URL pública del frontend (sitemap.xml y robots.txt)
APP_PUBLIC_URL=https://nexus.example.com

# Orígenes permitidos por CORS, separados por comas
CORS_ALLOWED_ORIGINS=https://nexus.example.com

# Base de datos (perfil prod)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexus
SPRING_DATASOURCE_USERNAME=nexus
SPRING_DATASOURCE_PASSWORD=

# Usa "native" solo si el backend está detrás de un proxy de confianza (nginx, etc.) que envía X-Forwarded-For
FORWARD_HEADERS_STRATEGY=none

# Directorio donde se guardan las imágenes subidas (se sirven en /uploads/news/**)
UPLOAD_DIR=./uploads

# Estrategia de esquema de Hibernate en prod (update, validate, none...)
JPA_DDL_AUTO=update

# Importación automática de noticias y ofertas (pon false en todas las réplicas menos una)
IMPORT_ENABLED=true
IMPORT_CHECK_INTERVAL=PT15M
IMPORT_SEED_DEFAULTS=true
