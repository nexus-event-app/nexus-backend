# Configuración del servidor de Primer Commit. Se copia a .env (lo hace ./preparar-servidor.sh) y se rellena allí.
# .env NUNCA se sube al repositorio: lleva contraseñas y datos legales.

# --- Web -------------------------------------------------------------------------------------------------------
# Dominio, sin https:// ni barra final (p. ej. primercommit.es). Debe apuntar ya a la IP del servidor.
DOMAIN=
# true durante la prueba con los compis: aviso «Beta» bajo la cabecera con enlace al foro.
VITE_BETA=true

# --- Secretos (preparar-servidor.sh los genera solos si están vacíos) -------------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=

# --- Administración ----------------------------------------------------------------------------------------------
# Tu cuenta de administradora: se crea al primer arranque. Usa una contraseña larga y única.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Ana

# --- «Continuar con Google» (opcional: vacío, el botón no sale) ---------------------------------------------------
# Cliente NUEVO «Primer Commit (producción)» en Google Cloud, con esta URI de redirección autorizada:
#   https://TU-DOMINIO/api/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (verificación de cuenta y recuperar contraseña) -------------------------------------------------------
# Con un proveedor SMTP (p. ej. Brevo). Sin email, pon REQUIRE_VERIFIED_EMAIL=false o nadie podrá publicar.
MAIL_ENABLED=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Primer Commit <hola@TU-DOMINIO>
REQUIRE_VERIFIED_EMAIL=true

# --- Noticias y ofertas automáticas ------------------------------------------------------------------------------
IMPORT_ENABLED=true

# --- Datos legales (aviso legal y privacidad) --------------------------------------------------------------------
# Se ven en la web. NIF y domicilio pueden quedar vacíos: entonces no se muestran.
VITE_LEGAL_OWNER_NAME=
VITE_LEGAL_OWNER_ID=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
VITE_LEGAL_HOSTING_PROVIDER=
