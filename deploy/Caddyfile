# HTTPS automático (Let's Encrypt) para el dominio de .env; todo lo demás lo sirve el frontend (nginx).
{$DOMAIN} {
	encode zstd gzip
	# HSTS: a partir de la primera visita, el navegador ya no usa http con este dominio.
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:8080
}

# La versión con www lleva a la principal.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
